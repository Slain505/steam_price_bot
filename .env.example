# Telegram bot token — get it from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SQLite database path (default: prices.db)
DB_PATH=prices.db

# Steam session cookie for accessing private inventories.
# How to get: log in at steamcommunity.com → F12 → Application → Cookies
#             → steamcommunity.com → copy value of "steamLoginSecure"
STEAM_SESSION_COOKIE=

# Display currency (default: USD)
# Supported: USD EUR GBP PLN UAH RUB KZT
STEAM_CURRENCY=USD
